FROM python:3.13-slim AS dependencies

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /bin/uv

WORKDIR /opt/ja-media

# Resolve third-party dependencies from metadata alone. This layer changes only
# when a lockfile or package declaration changes, not for ordinary source edits.
COPY pyproject.toml uv.lock README.md ./
COPY packages/core/pyproject.toml packages/core/pyproject.toml
COPY packages/data/pyproject.toml packages/data/pyproject.toml
COPY packages/media/pyproject.toml packages/media/pyproject.toml

RUN --mount=type=cache,id=ja-media-data-uv,target=/root/.cache/uv \
    uv sync \
      --frozen \
      --link-mode copy \
      --package ja-media-data \
      --no-dev \
      --no-install-workspace


FROM python:3.13-slim

RUN apt-get update \
    && apt-get install --no-install-recommends --yes curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ja-media

# The environment is a stable image layer. Workspace packages are installed
# only after their source is copied below, keeping source churn inexpensive.
COPY --from=dependencies /opt/ja-media/.venv .venv

COPY pyproject.toml uv.lock README.md ./
COPY packages/core packages/core
COPY packages/data packages/data
COPY packages/media packages/media

RUN --mount=from=ghcr.io/astral-sh/uv:0.8.22,source=/uv,target=/bin/uv \
    --mount=type=cache,id=ja-media-data-uv,target=/root/.cache/uv \
    uv sync \
      --frozen \
      --link-mode copy \
      --package ja-media-data \
      --no-dev

ENV DAGSTER_HOME=/var/lib/dagster/home
ENV PATH=/opt/ja-media/.venv/bin:$PATH
ENV PYTHONUNBUFFERED=1

ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF

RUN mkdir -p /var/lib/dagster/home

CMD ["dagster", "dev", "--host", "0.0.0.0", "--port", "3000", "--module-name", "ja_media_data.orchestration.dagster.definitions"]
