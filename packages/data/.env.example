# Copy this file to packages/data/.env and source it before `ja-data` commands.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage

JA_MEDIA_BRONZE_BUCKET=ja-media-prod
JA_MEDIA_S3_ENDPOINT_URL=http://magi06-storage:3900
JA_MEDIA_BRONZE_PREFIX=audio/anime/bronze
JA_MEDIA_S3_ADDRESSING_STYLE=path
JA_MEDIA_BRONZE_SCAN_EVENT_LIMIT=25

# Shared, flash-backed PostgreSQL control plane and DuckLake catalog.
# Percent-encode reserved password characters in the URL.
JA_MEDIA_DATA_DATABASE_URL=postgresql+psycopg://ja_media_service_user:encoded-password@postgres:5432/ja_media_data_dev

# Ordinary PostgreSQL schema for invariant-bearing human binding decisions.
# This must differ from the DuckLake catalog metadata schema.
JA_MEDIA_CONTROL_SCHEMA=ja_media_control

# DuckLake writes derived domain tables beneath this Garage path. Its separate
# PostgreSQL metadata schema is created if absent and never reset.
JA_MEDIA_DUCKLAKE_CATALOG_SCHEMA=ja_media_ducklake
JA_MEDIA_DUCKLAKE_DATA_PATH=s3://ja-media-prod/audio/anime/lakehouse/data/
# Optional overrides let bronze reads use Garage while DuckLake writes to a
# disposable local MinIO. Omit them when both paths share one S3 endpoint.
JA_MEDIA_DUCKLAKE_S3_ENDPOINT_URL=
JA_MEDIA_DUCKLAKE_S3_REGION=
JA_MEDIA_DUCKLAKE_S3_ACCESS_KEY_ID=
JA_MEDIA_DUCKLAKE_S3_SECRET_ACCESS_KEY=
