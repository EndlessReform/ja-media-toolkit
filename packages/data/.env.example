# Copy this file to packages/data/.env. Dagster loads that file when commands
# are run from this package directory.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage

JA_MEDIA_BRONZE_BUCKET=ja-media-prod
JA_MEDIA_S3_ENDPOINT_URL=http://magi06-storage:3900
JA_MEDIA_BRONZE_PREFIX=audio/anime/bronze
JA_MEDIA_S3_ADDRESSING_STYLE=path
JA_MEDIA_BRONZE_SCAN_EVENT_LIMIT=25

# Shared, flash-backed domain ledger. Percent-encode reserved password
# characters because this is a SQLAlchemy URL.
JA_MEDIA_DATA_DATABASE_URL=postgresql+psycopg://ja_media_service_user:encoded-password@postgres:5432/ja_media_data_dev
