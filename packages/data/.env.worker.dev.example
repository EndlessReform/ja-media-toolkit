# Local native worker -> persistent DEV.
#
# One-time setup:
#   cp packages/data/.env.worker.dev.example packages/data/.env.worker.dev
#
# Copy only the three values mapped below from /etc/ja-media/.env.dev on the
# DEV host. Never copy that complete file: it also contains database secrets
# that a native worker must not receive.
#
# DEV source: RABBITMQ_PASSWORD
RABBITMQ_PASSWORD=

# DEV source: JA_MEDIA_DUCKLAKE__S3_ACCESS_KEY_ID
JA_MEDIA_WORKER_STAGING_ACCESS_KEY_ID=

# DEV source: JA_MEDIA_DUCKLAKE__S3_SECRET_ACCESS_KEY
JA_MEDIA_WORKER_STAGING_SECRET_ACCESS_KEY=

# Bronze credentials are deliberately not duplicated here. The local worker
# loads the existing read-only bronze credentials from packages/data/.env.local.
# Stable broker/Garage endpoints, buckets, vhost, and staging prefix belong in
# the checked-in local-cpu worker profile rather than this secret file.
