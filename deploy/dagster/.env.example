# Copy this file to .env on the machine that runs the Dagster control plane.
# The PostgreSQL server is external to this Compose project; this stack does
# not create, migrate, back up, or otherwise manage that server.

COMPOSE_PROJECT_NAME=dagster

# Dagster core and its integration libraries use paired release lines. Upgrade
# them together, then build and verify before removing the old image.
DAGSTER_VERSION=1.13.12
DAGSTER_LIBRARY_VERSION=0.29.12
DAGSTER_IMAGE=ja-media/dagster:1.13.12

# This control-plane VM is expected to be protected by the homelab network,
# tailnet, and host firewall. Dagster OSS does not provide authentication, so
# do not expose this port to the public internet.
DAGSTER_WEB_BIND_ADDR=0.0.0.0
DAGSTER_WEB_PORT=3000

# Required: an existing PostgreSQL database configured with UTC timezone.
# The hostname must be reachable from inside Docker. On Docker Desktop or
# OrbStack, use host.docker.internal when PostgreSQL runs on this same Mac.
DAGSTER_PG_HOST=host.docker.internal
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USERNAME=dagster
DAGSTER_PG_PASSWORD=change-me

# Local compute logs and temporary artifacts are not stored in PostgreSQL.
# This host directory is mounted into all three Dagster processes.
DAGSTER_DATA_PATH=./data

# Limit concurrently launched runs while the spike is small.
DAGSTER_MAX_CONCURRENT_RUNS=2
