# Copy to /etc/ja-media/.env.dev and chmod 0600.
#
# Generate this Compose-owned broker's initial password with, for example,
# `openssl rand -hex 32`. RabbitMQ applies it when initializing an empty named
# volume; changing this file later does not rotate the stored broker password.
RABBITMQ_PASSWORD=replace-with-url-safe-secret

# External PostgreSQL database dedicated to Dagster run and event storage.
DAGSTER_POSTGRES_URL=postgresql://ja_media_dagster_dev:secret@postgres.example.ts.net/ja_media_dagster_dev

# External application PostgreSQL database used by DuckLake and control data.
JA_MEDIA_DUCKLAKE__POSTGRES_URL=postgresql://ja_media_data_dev:secret@postgres.example.ts.net/ja_media_data_dev

# Existing read-only Garage credentials for the bronze bucket/prefix.
JA_MEDIA_BRONZE__ACCESS_KEY_ID=replace-me
JA_MEDIA_BRONZE__SECRET_ACCESS_KEY=replace-me

# Existing read/write Garage credentials for the DEV DuckLake bucket/prefix.
JA_MEDIA_DUCKLAKE__S3_ACCESS_KEY_ID=replace-me
JA_MEDIA_DUCKLAKE__S3_SECRET_ACCESS_KEY=replace-me

# Bind these to the VM's tailnet address when remote access is desired.
JA_MEDIA_DEV_HTTP_BIND=127.0.0.1
JA_MEDIA_DEV_AMQP_BIND=127.0.0.1
