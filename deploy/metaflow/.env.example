# Copy to .env on the machine that runs this stack.
# This deployment is intentionally homelab/ML-control-plane shaped, not
# ja-media shaped. Project data buckets should be configured by the flows.

COMPOSE_PROJECT_NAME=metaflow

# Published by Netflix/Outerbounds for the metadata, migration, and UI backend
# service. This stack builds a tiny local derivative because upstream's
# migration URL escaping is not safe for arbitrary generated passwords.
METAFLOW_SERVICE_BASE_IMAGE=netflixoss/metaflow_metadata_service:latest
METAFLOW_SERVICE_IMAGE=metaflow-metadata-service:local
METAFLOW_UI_IMAGE=metaflow-ui:local
METAFLOW_UI_REF=v1.3.13
POSTGRES_IMAGE=postgres:15-alpine
CADDY_IMAGE=caddy:2.8-alpine

# The VM's Tailscale MagicDNS name should be <machineid>-metaflow. This stack
# owns that name with:
#   http://<machineid>-metaflow/      -> Metaflow UI
#   http://<machineid>-metaflow:8080/ -> Metaflow metadata API
CADDY_BIND_ADDR=0.0.0.0
CADDY_UI_PORT=80
CADDY_METADATA_PORT=8080
MF_UI_FRONTEND_PORT=3000

MF_METADATA_PORT=8080
MF_MIGRATION_PORT=8082
MF_UI_METADATA_PORT=8083

POSTGRES_DB=metaflow
POSTGRES_USER=metaflow
POSTGRES_PASSWORD=change-me

# Optional: allow the UI backend to read S3-backed artifacts for runs produced
# by workers. This is not required for the metadata service itself.
FEATURE_S3_DISABLE=1
# METAFLOW_DEFAULT_DATASTORE=s3
# METAFLOW_DATASTORE_SYSROOT_S3=s3://metaflow-system/metaflow
# METAFLOW_S3_ENDPOINT_URL=http://garage.example.lan:3900
# AWS_DEFAULT_REGION=garage
# AWS_ACCESS_KEY_ID=metaflow-system-access-key
# AWS_SECRET_ACCESS_KEY=metaflow-system-secret-key

# Optional UI/backend tuning. Keep these boring until there is a real problem.
LOGLEVEL=INFO
PREFETCH_RUNS_SINCE=2592000
PREFETCH_RUNS_LIMIT=25
